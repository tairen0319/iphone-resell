rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // オーナー(あなた)のみ読み書き可。
    // Firebase Authenticationでメール/パスワード等のアカウントを1つ作成し、
    // そのUIDを下のOWNER_UIDに設定してから firebase deploy --only firestore:rules で反映する。
    function isOwner() {
      return request.auth != null && request.auth.uid == "jfdQgdFdN5U9qGW6sFpKgIcpI9e2";
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
